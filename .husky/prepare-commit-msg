#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Obter o próximo número de commit
COMMIT_COUNT=$(git rev-list --count HEAD 2>/dev/null)
if [ -z "$COMMIT_COUNT" ]; then
  # Se não houver commits ainda, começar do 1
  NEXT_COMMIT=1
else
  # Adicionar 1 ao número atual de commits
  NEXT_COMMIT=$((COMMIT_COUNT + 1))
fi

# Ler a mensagem de commit atual
COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Verificar se a mensagem já tem um ID de commit
if ! echo "$COMMIT_MSG" | grep -q "#[0-9]\+"; then
  # Adicionar o ID de commit à mensagem
  echo "$COMMIT_MSG (#$NEXT_COMMIT)" > "$COMMIT_MSG_FILE"
fi
